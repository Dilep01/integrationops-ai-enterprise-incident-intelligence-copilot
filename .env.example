INTEGRATIONOPS_ENV=development
INTEGRATIONOPS_LOG_LEVEL=INFO
INTEGRATIONOPS_DATABASE_URL=sqlite:///./.data/integrationops.db
INTEGRATIONOPS_CHECKPOINT_PATH=.data/checkpoints.sqlite3
INTEGRATIONOPS_QDRANT_URL=http://qdrant:6333
INTEGRATIONOPS_EMBEDDING_PROVIDER=hashing
INTEGRATIONOPS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
INTEGRATIONOPS_RERANKER_PROVIDER=lexical
INTEGRATIONOPS_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
INTEGRATIONOPS_RETRIEVAL_CANDIDATE_LIMIT=12
INTEGRATIONOPS_RETRIEVAL_MAX_CHUNKS_PER_DOCUMENT=1
INTEGRATIONOPS_LLM_PROVIDER=mock
INTEGRATIONOPS_LLM_MODEL=deterministic-phase-3
INTEGRATIONOPS_LLM_BASE_URL=http://localhost:11434/v1
INTEGRATIONOPS_OLLAMA_BASE_URL=http://host.docker.internal:11434
INTEGRATIONOPS_LLM_API_KEY=
INTEGRATIONOPS_LLM_TIMEOUT_SECONDS=30
INTEGRATIONOPS_AUTH_MODE=headers
INTEGRATIONOPS_TELEMETRY_SERVICE_NAME=integrationops-api
INTEGRATIONOPS_REMEDIATION_PROVIDER=sandbox
INTEGRATIONOPS_REMEDIATION_BASE_URL=http://127.0.0.1:8081
INTEGRATIONOPS_REMEDIATION_API_KEY=
INTEGRATIONOPS_REMEDIATION_TIMEOUT_SECONDS=2
INTEGRATIONOPS_REMEDIATION_MAX_ATTEMPTS=3
INTEGRATION_RUNTIME_API_KEY=local-demo-key
INTEGRATION_RUNTIME_TIMEOUT_SIMULATION_SECONDS=2
